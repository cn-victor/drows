# Copy this file to ".env.local" and fill in the values. Never share .env.local or put it on GitHub.

# AI reader voice (OpenAI speech). Leave empty to use the free browser voice instead.
OPENAI_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts

# Online database (Turso). Leave empty to use the local file data/poems.db.
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# The platform's wallet address: receives the 15% share of every gift.
PLATFORM_WALLET=
# Solana network: "devnet" (test money) or "mainnet-beta" (real money).
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional: a faster Solana connection (e.g. from Helius or QuickNode)
# NEXT_PUBLIC_SOLANA_RPC=
